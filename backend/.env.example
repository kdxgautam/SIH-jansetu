DATABASE_URL=postgresql+psycopg://sih:sih_local_only@localhost:54329/sih
# For Neon use its direct connection URL with sslmode=require, retaining
# the postgresql+psycopg:// SQLAlchemy driver prefix. Never commit credentials.
APP_ORIGIN=http://localhost:3000
# Optional exact origins (comma-separated) and a scoped HTTPS Vercel preview host pattern.
APP_ORIGINS=
APP_ORIGIN_PREVIEW_PREFIX=
APP_ORIGIN_PREVIEW_SUFFIX=
# Proxies you control between the browser and this API (Vercel in front of Cloud Run
# is 2). Leave 0 when the API is reached directly. Without it every request appears
# to come from the proxy, and one shared address exhausts the sign-in ceiling for
# everyone at once.
TRUSTED_PROXY_HOPS=0
UPLOAD_DIR=.data/uploads
# A container filesystem is discarded on every redeploy and is not shared between
# instances. Name a private Cloud Storage bucket to keep evidence instead; downloads
# still stream through the API, so the same authorization applies.
UPLOAD_BUCKET=
UPLOAD_PREFIX=evidence
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_APPLICATION_CREDENTIALS=../application_default_credentials.json
GOOGLE_CLOUD_LOCATION=global
DEMO_PASSWORD=DemoPass123!
